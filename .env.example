# Copy to .env to change settings. Every value below is optional; the defaults run offline.

# Which LLM adapter to use: fake (default, offline, deterministic) | anthropic | openai
JUDGE_LLM_PROVIDER=fake

# Models for each stage. Extraction is high volume and simple, so it uses a cheaper model.
JUDGE_EXTRACTION_MODEL=claude-haiku-5-5
JUDGE_ASSESSMENT_MODEL=claude-opus-5-5

# Reasoning effort for the Anthropic adapter: low | medium | high | xhigh | max
JUDGE_EFFORT=medium

# Verdicts below this confidence go to human review as `unclear`.
JUDGE_CONFIDENCE_THRESHOLD=0.6

# Fake adapter only: share of evidence quotes it paraphrases, to exercise the grounding check.
JUDGE_FAKE_QUOTE_DRIFT=0.03

# Regression gate: CI fails if golden macro F1 drops more than this below eval/baseline.json.
JUDGE_GATE_TOLERANCE=0.02

# Paths (relative paths resolve from the current directory)
# JUDGE_DATA_DIR=data
# JUDGE_DB_PATH=.judge/judge.db
# JUDGE_RULEBOOK=config/rulebook.yaml

# Provider keys, only needed for live adapters. Never commit real keys.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Set to 1 to include the live-model test in pytest runs (costs money).
# JUDGE_LIVE_TESTS=0
